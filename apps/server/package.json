{
  "name": "@raisechat/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "e2e": "node --import tsx src/e2e.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@node-rs/argon2": "^2.2.2",
    "@raisechat/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
