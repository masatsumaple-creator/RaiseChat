{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status*)",
      "PowerShell(git status*)",
      "Bash(git log*)",
      "PowerShell(git log*)",
      "Bash(git diff*)",
      "PowerShell(git diff*)",
      "Bash(git show*)",
      "PowerShell(git show*)",
      "Bash(git branch)",
      "PowerShell(git branch)",
      "Bash(git branch -a)",
      "PowerShell(git branch -a)",
      "Bash(git branch -v)",
      "PowerShell(git branch -v)",
      "Bash(git branch -vv)",
      "PowerShell(git branch -vv)",
      "Bash(git branch -r)",
      "PowerShell(git branch -r)",
      "Bash(git branch --list)",
      "PowerShell(git branch --list)",
      "Bash(git branch --show-current)",
      "PowerShell(git branch --show-current)",
      "Bash(git blame *)",
      "PowerShell(git blame *)",
      "Bash(git grep *)",
      "PowerShell(git grep *)",
      "Bash(git ls-files*)",
      "PowerShell(git ls-files*)",
      "Bash(git rev-parse *)",
      "PowerShell(git rev-parse *)",
      "Bash(git remote -v)",
      "PowerShell(git remote -v)",
      "Bash(git remote show *)",
      "PowerShell(git remote show *)",
      "Bash(git stash list)",
      "PowerShell(git stash list)",
      "Bash(git config --get *)",
      "PowerShell(git config --get *)",
      "Bash(git --version)",
      "PowerShell(git --version)",
      "Bash(gh pr view*)",
      "PowerShell(gh pr view*)",
      "Bash(gh pr list*)",
      "PowerShell(gh pr list*)",
      "Bash(gh pr status*)",
      "PowerShell(gh pr status*)",
      "Bash(gh pr diff*)",
      "PowerShell(gh pr diff*)",
      "Bash(gh pr checks*)",
      "PowerShell(gh pr checks*)",
      "Bash(gh run list*)",
      "PowerShell(gh run list*)",
      "Bash(gh run view*)",
      "PowerShell(gh run view*)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "PowerShell(git push --force-with-lease*)",
      "Bash(git clean -f*)",
      "PowerShell(git clean -f*)",
      "Bash(git branch -D*)",
      "PowerShell(git branch -D*)",
      "Bash(git push origin main*)",
      "PowerShell(git push origin main*)",
      "Bash(git push -u origin main*)",
      "PowerShell(git push -u origin main*)",
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)",
      "Bash(rm *)",
      "PowerShell(rm *)",
      "Bash(rm)",
      "PowerShell(rm)",
      "Bash(Remove-Item*)",
      "PowerShell(Remove-Item*)",
      "Bash(Move-Item*)",
      "PowerShell(Move-Item*)"
    ]
  }
}
