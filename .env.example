# apps/server が読み込む環境変数の例。実際の値は .env に書く(.env は Git に入れない)
DATABASE_URL=postgres://raisechat:raisechat@localhost:5432/raisechat
# 許可するオリジン(Origin ヘッダの検証に使う。設計書 §4.1)
ALLOWED_ORIGIN=http://localhost:5173
PORT=3000
# 信頼するプロキシのアドレス(カンマ区切り。CIDR 可。設計書 §4.1)。
# リバースプロキシの背後に置く場合だけ設定する。未設定なら X-Forwarded-For を無視する
TRUSTED_PROXIES=

# アップロードされたファイル(アバターなど)の保存先。相対パスは、サーバーを起動した場所から(開発用。本番は S3 互換に差し替える)
STORAGE_DIR=./storage
